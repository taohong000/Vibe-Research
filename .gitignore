# 用户私有层:配置 / 运行产物 / 知识层私有档案,永不入库
.local/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/

# 环境与密钥
.env
.env.*
!.env.example
*.key
*.pem

# 系统与日志
.DS_Store
*.log

# WorkBuddy / CodeBuddy 的项目数据（会话、记忆、每日工作日志）:本机工具产物,不入库
.workbuddy/

# 根目录偶然生成的 npm 锁文件(上游没有根 package.json,这份是本地跑出来的)
/package-lock.json
